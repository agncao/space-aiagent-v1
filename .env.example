# ============================================
# space-aiagent 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# .env 文件已被 .gitignore 排除，不会被提交到 Git
# ============================================

# ---- 运行环境 ----
APP_ENV=dev

# ---- 大语言模型配置 ----
# 适用于所有 OpenAI 兼容接口（DeepSeek、Qwen/DashScope、OpenAI 等）
# 切换提供商只需修改 BASE_URL 和 MODEL 即可
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

LLM_FLASH_API_KEY=your-api-key
LLM_FLASH_BASE_URL=https://api.deepseek.com
LLM_FLASH_MODEL=deepseek-chat

# ---- 可观测性（Langfuse v3 自部署）----
# 留空则 observability.enabled=false（即使 yaml 中设为 true，SDK 也会以 tracing_enabled=false 启动）
# 启动 Langfuse 后，docker-compose 会用 LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY 自动创建项目
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- Langfuse docker-compose 所需（docker/observability/docker-compose.yml）----
# 凭证生成：openssl rand -base64 32（NEXTAUTH_SECRET / SALT / ENCRYPTION_KEY 各一个）
LANGFUSE_NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
LANGFUSE_SALT=replace-with-openssl-rand-base64-32
LANGFUSE_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# 首次启动自动初始化的项目信息（不填则用 docker-compose.yml 中的默认值，登录 UI 修改密码）
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-space-aiagent-dev
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-space-aiagent-dev
LANGFUSE_INIT_USER_EMAIL=admin@space-aiagent.local
LANGFUSE_INIT_USER_PASSWORD=SpaceAIAgent2026!
