# ============================================
# space-aiagent 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# .env 文件已被 .gitignore 排除，不会被提交到 Git
# ============================================

# ---- 运行环境 ----
APP_ENV=dev

# ---- 大语言模型配置 ----
# 适用于所有 OpenAI 兼容接口（DeepSeek、Qwen/DashScope、OpenAI 等）
# 切换提供商只需修改 BASE_URL 和 MODEL 即可
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

LLM_FLASH_API_KEY=your-api-key
LLM_FLASH_BASE_URL=https://api.deepseek.com
LLM_FLASH_MODEL=deepseek-chat
