# ============================================
# space-aiagent 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# .env 文件已被 .gitignore 排除，不会被提交到 Git
# ============================================

# ---- 运行环境 ----
APP_ENV=dev

# ---- 服务器配置 ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8028

# ---- 大语言模型配置 ----
# 适用于所有 OpenAI 兼容接口（DeepSeek、Qwen/DashScope、OpenAI 等）
# 切换提供商只需修改 BASE_URL 和 MODEL 即可
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0     # 可选，覆盖 application.yaml 中的 agent.temperature
# LLM_STREAMING=true    # 可选，覆盖 application.yaml 中的 agent.streaming

# ---- 数据库 ----
DATABASE_URL=sqlite+aiosqlite:///./data/space_aiagent.db

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_DIR=./logs
